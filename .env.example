# Zona horaria (identificador IANA) con la que se calculan «hoy» y «mañana».
# Si el valor no es una zona válida, la aplicación no arranca.
APP_TIMEZONE=Europe/Madrid

# Marca las cookies de sesión (JSESSIONID) y CSRF (XSRF-TOKEN) como Secure: solo viajan por HTTPS.
# Déjalo en false en local (http://localhost) y ponlo a true en producción.
APP_COOKIE_SECURE=false

# Límite de intentos de inicio de sesión por email e IP del cliente. Tras LOGIN_MAX_INTENTOS fallos
# dentro de LOGIN_VENTANA_MINUTOS (contados desde el primer fallo), el login responde 429 hasta que
# termina la ventana. LOGIN_MAX_ENTRADAS limita cuántas combinaciones email e IP se guardan en memoria.
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MINUTOS=15
LOGIN_MAX_ENTRADAS=10000

# Solo detrás de un proxy inverso de confianza: toma la IP del cliente de X-Forwarded-For.
# Sin proxy, déjalo en none: cualquiera podría falsear la cabecera.
SERVER_FORWARD_HEADERS_STRATEGY=none

# Administrador inicial. Se crea al arrancar si no existe un usuario con ese email.
# Sin ADMIN_PASSWORD no se crea (se avisa en el log). Contraseña de 72 bytes como máximo.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Opcional; por defecto «Administrador».
ADMIN_NOMBRE=

# Usuario de prueba con rol USER. Solo con el perfil dev y si hay email y contraseña.
DEMO_EMAIL=
DEMO_PASSWORD=
# Opcional; por defecto «Usuario de prueba».
DEMO_NOMBRE=
